#!/bin/sh
set -eu

cd "$(dirname "$0")"

cleanup_pyapp() {
    echo "Initialization failed. Cleaning up, please try to run it again"
    ./configurator self remove
    exit 1
}

echo Initializing, please wait...
if ! ./configurator learn2rag.noop; then
    cleanup_pyapp
fi
echo ========================================
echo Starting Learn2RAG...
LEARN2RAG_PATH=. \
./configurator
