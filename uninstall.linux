#!/bin/sh
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -f "$SCRIPT_DIR/remove-learn2rag-software.sh" ]; then
    /bin/sh "$SCRIPT_DIR/remove-learn2rag-software.sh"
else
    echo "Error: $SCRIPT_DIR/remove-learn2rag-software.sh not found." >&2
    exit 1
fi

echo ""

printf "Do you also want to remove all personal user data (databases, configs)? (y/N): "
read -r PURGE_DATA

case "$PURGE_DATA" in
    [yY][eE][sS]|[yY])
        if [ -f "$SCRIPT_DIR/remove-user-data.sh" ]; then
            /bin/sh "$SCRIPT_DIR/remove-user-data.sh" -y
        else
            echo "Error: $SCRIPT_DIR/remove-user-data.sh not found." >&2
            exit 1
        fi
        ;;
    *)
        echo "User data preserved."
        ;;
esac

echo "Uninstall process finished."
