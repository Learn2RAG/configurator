#!/bin/sh
set -eu

# Public address of the wiki; set MEDIAWIKI_URL when it is served under another host name
URL="${MEDIAWIKI_URL:-http://localhost:7338}"

if [ ! -e "./LocalSettings.php" ]; then
    runuser -u www-data -- \
    php ./maintenance/install.php \
    --dbtype sqlite \
    --dbname test \
    --server "$URL" \
    --scriptpath "" \
    --lang en \
    --pass uniquetest \
    "Test" "admin"

    cat /opt/LocalSettings.php >>./LocalSettings.php
fi

docker-php-entrypoint apache2-foreground
